<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaVersion Condition="'$(AvaloniaVersion)' == ''">11.3.22</AvaloniaVersion>
    <SourceProject Condition="'$(SourceProject)' == ''">$(MSBuildThisFileDirectory)../../src/SourceGit.csproj</SourceProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(SourceProject)" />
    <PackageReference Include="Avalonia.Headless" Version="$(AvaloniaVersion)" />
  </ItemGroup>
</Project>
