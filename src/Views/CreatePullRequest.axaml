<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:c="using:SourceGit.Converters"
             xmlns:m="using:SourceGit.Models"
             xmlns:vm="using:SourceGit.ViewModels"
             xmlns:v="using:SourceGit.Views"
             mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="450"
             x:Class="SourceGit.Views.CreatePullRequest"
             x:DataType="vm:CreatePullRequest">
  <StackPanel Orientation="Vertical" Margin="8,0">
    <StackPanel Orientation="Horizontal">
      <Path Width="16" Height="16"
            Data="{StaticResource Icons.CreatePR}"/>

      <TextBlock FontSize="18"
                 Margin="8,0,0,0"
                 Classes="bold"
                 Text="{DynamicResource Text.CreatePR}"/>
    </StackPanel>

    <Grid Margin="0,16,0,0" RowDefinitions="32,Auto,32,Auto,Auto,32,Auto,Auto,Auto" ColumnDefinitions="130,*">
      <!-- Source -->
      <TextBlock Grid.Row="0" Grid.Column="0"
                 HorizontalAlignment="Right" VerticalAlignment="Center"
                 Margin="0,0,8,0"
                 Text="{DynamicResource Text.CreatePR.Source}"/>
      <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Path Width="14" Height="14" Margin="4,0,8,0" Data="{StaticResource Icons.Branch}"/>
        <TextBlock Text="{Binding Source.Name}"/>
        <Border Height="18"
                Margin="8,0,0,0"
                Padding="8,0"
                VerticalAlignment="Center"
                CornerRadius="9"
                Background="{DynamicResource Brush.Badge}"
                IsVisible="{Binding Source.IsTrackStatusVisible}">
          <TextBlock Foreground="{DynamicResource Brush.BadgeFG}"
                     FontFamily="{DynamicResource Fonts.Monospace}"
                     FontSize="10"
                     Text="{Binding Source.TrackStatusDescription}"/>
        </Border>
      </StackPanel>

      <!-- Remote to push the source branch (only for branches without upstream) -->
      <TextBlock Grid.Row="1" Grid.Column="0"
                 HorizontalAlignment="Right" VerticalAlignment="Center"
                 Margin="0,0,8,0"
                 Text="{DynamicResource Text.CreatePR.PushRemote}"
                 IsVisible="{Binding IsPushRemoteSelectable}"/>
      <ComboBox Grid.Row="1" Grid.Column="1"
                Height="28" Margin="0,2" Padding="8,0"
                VerticalAlignment="Center" HorizontalAlignment="Stretch"
                ItemsSource="{Binding PushRemotes}"
                SelectedItem="{Binding SelectedPushRemote, Mode=TwoWay}"
                IsVisible="{Binding IsPushRemoteSelectable}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="{x:Type m:Remote}">
            <StackPanel Orientation="Horizontal" Height="20" VerticalAlignment="Center">
              <Path Margin="0,2,8,0" Width="14" Height="14" Fill="{DynamicResource Brush.FG1}" Data="{StaticResource Icons.Remote}"/>
              <TextBlock Text="{Binding Name}"/>
            </StackPanel>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <!-- Target -->
      <TextBlock Grid.Row="2" Grid.Column="0"
                 HorizontalAlignment="Right" VerticalAlignment="Center"
                 Margin="0,0,8,0"
                 Text="{DynamicResource Text.CreatePR.Target}"/>
      <v:BranchSelector Grid.Row="2" Grid.Column="1"
                        Height="28"
                        VerticalAlignment="Center" HorizontalAlignment="Stretch"
                        Branches="{Binding TargetBranches, Mode=OneWay}"
                        SelectedBranch="{Binding SelectedTarget, Mode=TwoWay}"/>

      <!-- Platform (only when it can not be detected from host) -->
      <TextBlock Grid.Row="3" Grid.Column="0"
                 HorizontalAlignment="Right" VerticalAlignment="Center"
                 Margin="0,0,8,0"
                 Text="{DynamicResource Text.CreatePR.Platform}"
                 IsVisible="{Binding IsPlatformSelectable}"/>
      <ComboBox Grid.Row="3" Grid.Column="1"
                Height="28" Margin="0,2" Padding="8,0"
                VerticalAlignment="Center" HorizontalAlignment="Stretch"
                ItemsSource="{Binding Platforms}"
                SelectedItem="{Binding SelectedPlatform, Mode=TwoWay}"
                IsVisible="{Binding IsPlatformSelectable}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="{x:Type m:PullRequestPlatform}">
            <TextBlock Text="{Binding Name}"/>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <!-- Template -->
      <TextBlock Grid.Row="4" Grid.Column="0"
                 HorizontalAlignment="Right" VerticalAlignment="Center"
                 Margin="0,0,8,0"
                 Text="{DynamicResource Text.CreatePR.Template}"
                 IsVisible="{Binding Templates, Converter={x:Static c:ListConverters.IsNotNullOrEmpty}}"/>
      <ComboBox Grid.Row="4" Grid.Column="1"
                Height="28" Margin="0,2" Padding="8,0"
                VerticalAlignment="Center" HorizontalAlignment="Stretch"
                ItemsSource="{Binding Templates}"
                SelectedItem="{Binding SelectedTemplate, Mode=TwoWay}"
                IsVisible="{Binding Templates, Converter={x:Static c:ListConverters.IsNotNullOrEmpty}}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="{x:Type m:PullRequestTemplate}">
            <TextBlock Text="{Binding Name}"/>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <!-- Title -->
      <TextBlock Grid.Row="5" Grid.Column="0"
                 HorizontalAlignment="Right" VerticalAlignment="Center"
                 Margin="0,0,8,0"
                 Text="{DynamicResource Text.CreatePR.Title}"/>
      <TextBox Grid.Row="5" Grid.Column="1"
               Height="26"
               VerticalAlignment="Center"
               CornerRadius="2"
               Text="{Binding Title, Mode=TwoWay}"/>

      <!-- Description -->
      <TextBlock Grid.Row="6" Grid.Column="0"
                 HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,10,8,0"
                 Text="{DynamicResource Text.CreatePR.Description}"/>
      <TextBox Grid.Row="6" Grid.Column="1"
               Height="160" Margin="0,4,0,0"
               AcceptsReturn="True" AcceptsTab="False"
               TextWrapping="Wrap"
               VerticalAlignment="Center" VerticalContentAlignment="Top"
               CornerRadius="3"
               Text="{Binding Description, Mode=TwoWay}"
               Tag="{Binding Source={x:Static v:StealHotKey.Enter}}"/>

      <!-- Push first -->
      <CheckBox Grid.Row="7" Grid.Column="1"
                Height="32" Margin="0,4,0,0"
                IsChecked="{Binding PushFirst, Mode=TwoWay}"
                IsVisible="{Binding NeedsPush}">
        <Panel>
          <TextBlock Text="{DynamicResource Text.CreatePR.PushBranchFirst}" IsVisible="{Binding IsPushRemoteSelectable}"/>
          <TextBlock Text="{DynamicResource Text.CreatePR.PushCommitsFirst}" IsVisible="{Binding !IsPushRemoteSelectable}"/>
        </Panel>
      </CheckBox>

      <!-- Hints -->
      <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Vertical" Margin="0,4,0,0">
        <Grid ColumnDefinitions="Auto,*" Margin="0,2" IsVisible="{Binding NeedsPush}">
          <Path Grid.Column="0"
                Width="14" Height="14"
                VerticalAlignment="Top" Margin="0,2,0,0"
                Data="{StaticResource Icons.Error}"
                Fill="DarkOrange"/>
          <TextBlock Grid.Column="1" Margin="8,0,0,0"
                     Text="{DynamicResource Text.CreatePR.BranchNotPushed}"
                     TextWrapping="Wrap"
                     Foreground="DarkOrange"
                     IsVisible="{Binding IsPushRemoteSelectable}"/>
          <TextBlock Grid.Column="1" Margin="8,0,0,0"
                     Text="{DynamicResource Text.CreatePR.CommitsNotPushed}"
                     TextWrapping="Wrap"
                     Foreground="DarkOrange"
                     IsVisible="{Binding !IsPushRemoteSelectable}"/>
        </Grid>

        <Grid ColumnDefinitions="Auto,*" Margin="0,2" IsVisible="{Binding IsClipboardHintVisible}">
          <Path Grid.Column="0"
                Width="14" Height="14"
                VerticalAlignment="Top" Margin="0,2,0,0"
                Data="{StaticResource Icons.Info}"
                Fill="{DynamicResource Brush.FG2}"/>
          <TextBlock Grid.Column="1" Margin="8,0,0,0"
                     Text="{DynamicResource Text.CreatePR.ClipboardHint}"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource Brush.FG2}"/>
        </Grid>
      </StackPanel>
    </Grid>
  </StackPanel>
</UserControl>
