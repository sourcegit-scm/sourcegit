<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:m="using:SourceGit.Models"
             xmlns:vm="using:SourceGit.ViewModels"
             xmlns:v="using:SourceGit.Views"
             xmlns:c="using:SourceGit.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SourceGit.Views.ImageDiffView"
             x:DataType="m:ImageDiff">
  <Grid RowDefinitions="Auto,*">
    <!-- Zoom and Diff Toolbar -->
    <Border Grid.Row="0" Margin="8,4,8,0" HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel Orientation="Horizontal" Spacing="6" Height="24" VerticalAlignment="Center">
        <Path Width="14" Height="14" Data="{StaticResource Icons.Explore}" Fill="{DynamicResource Brush.FG2}" VerticalAlignment="Center"/>
        <TextBlock Text="{DynamicResource Text.Diff.Image.Zoom}" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource Brush.FG2}"/>

        <Button Classes="icon_button" Width="16" Height="16" Padding="0" Click="OnZoomOut" ToolTip.Tip="-">
          <Path Width="10" Height="10" Stretch="Uniform" Fill="{DynamicResource Brush.FG1}" Data="M0 0M1024 1024 M128 448h768v128H128z"/>
        </Button>

        <Slider x:Name="ImageZoomSlider"
                Width="120"
                Minimum="0.5" Maximum="8.0"
                Value="1.0"
                TickFrequency="0.25"
                VerticalAlignment="Center"/>

        <TextBlock Text="{Binding #ImageZoomSlider.Value, Converter={x:Static c:DoubleConverters.ToPercentage}}"
                   Width="40"
                   TextAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="11"
                   Foreground="{DynamicResource Brush.FG1}"/>

        <Button Classes="icon_button" Width="16" Height="16" Padding="0" Click="OnZoomIn" ToolTip.Tip="+">
          <Path Width="10" Height="10" Stretch="Uniform" Fill="{DynamicResource Brush.FG1}" Data="M0 0M1024 1024 M128 448h320V128h128v320h320v128H576v320H448V576H128V448z"/>
        </Button>

        <Button Classes="flat" Padding="6,2" Click="OnZoomReset" ToolTip.Tip="1:1 / Fit">
          <TextBlock Text="{DynamicResource Text.Diff.Image.ResetZoom}" FontSize="10"/>
        </Button>

        <Rectangle Width="1" Height="14" Fill="{DynamicResource Brush.Border1}" Margin="4,0"/>

        <ToggleButton Classes="flat"
                      Padding="6,2"
                      IsChecked="{Binding Source={x:Static vm:Preferences.Instance}, Path=HighlightImageDiffChanges, Mode=TwoWay}"
                      ToolTip.Tip="{DynamicResource Text.Diff.Image.HighlightChanges}">
          <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
            <Path Width="12" Height="12" Data="{StaticResource Icons.Eye}" Fill="{DynamicResource Brush.FG1}"/>
            <TextBlock Text="{DynamicResource Text.Diff.Image.HighlightChanges}" FontSize="10" VerticalAlignment="Center"/>
            <Border Background="{DynamicResource Brush.Badge}"
                    CornerRadius="6"
                    Height="14"
                    Padding="4,0"
                    VerticalAlignment="Center"
                    IsVisible="{Binding Source={x:Static vm:Preferences.Instance}, Path=HighlightImageDiffChanges}">
              <TextBlock Text="{Binding ChangeCount}" FontSize="9" Foreground="{DynamicResource Brush.BadgeFG}" VerticalAlignment="Center"/>
            </Border>
          </StackPanel>
        </ToggleButton>

        <Rectangle Width="1" Height="14" Fill="{DynamicResource Brush.Border1}" Margin="4,0"/>

        <!-- Difference statistics (pixels and changed areas) -->
        <Border Background="{DynamicResource Brush.Badge}" CornerRadius="4" Padding="6,3" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
            <Path Width="11" Height="11" Data="{StaticResource Icons.Diff}" Fill="{DynamicResource Brush.FG2}" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding DiffPixelStatsText}" FontSize="10" Foreground="{DynamicResource Brush.FG1}" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding DiffAreaStatsText}" FontSize="10" Foreground="{DynamicResource Brush.Accent}" FontWeight="Bold" VerticalAlignment="Center"
                       IsVisible="{Binding Source={x:Static vm:Preferences.Instance}, Path=HighlightImageDiffChanges}"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>

    <TabControl Grid.Row="1" SelectedIndex="{Binding Source={x:Static vm:Preferences.Instance}, Path=ImageDiffActiveIdx, Mode=TwoWay}" Margin="0,0,0,8" TabStripPlacement="Bottom">
      <TabControl.Styles>
        <Style Selector="TabControl /template/ ItemsPresenter#PART_ItemsPresenter > WrapPanel">
          <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
      </TabControl.Styles>

      <TabItem>
        <TabItem.Header>
          <TextBlock Text="{DynamicResource Text.Diff.Image.SideBySide}" FontSize="11"/>
        </TabItem.Header>

        <Grid ColumnDefinitions="*,*" Margin="8,8">
          <Grid Grid.Column="0" RowDefinitions="Auto,*" Margin="8,0" IsVisible="{Binding Old, Converter={x:Static ObjectConverters.IsNotNull}}">
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
              <Border Height="16" Background="{DynamicResource Brush.Badge}" CornerRadius="8" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource Text.Diff.Old}" Margin="8,0" FontSize="10" Foreground="{DynamicResource Brush.BadgeFG}"/>
              </Border>

              <TextBlock Text="{Binding OldImageSize}" Margin="8,0,0,0"/>
              <TextBlock Text="{Binding OldFileSize, Converter={x:Static c:LongConverters.ToFileSize}}" Foreground="{DynamicResource Brush.FG2}" Margin="16,0,0,0"/>
            </StackPanel>

            <Border Grid.Row="1" Margin="0,4,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Effect="drop-shadow(0 0 8 #A0000000)">
              <Border Background="{DynamicResource Brush.Popup}" Padding="8">
                <ScrollViewer x:Name="OldImageScrollViewer"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              ScrollChanged="OnOldImageScrollChanged"
                              PointerWheelChanged="OnImagePointerWheelChanged"
                              PointerPressed="OnImagePointerPressed"
                              PointerMoved="OnImagePointerMoved"
                              PointerReleased="OnImagePointerReleased"
                              PointerCaptureLost="OnImagePointerCaptureLost">
                  <Border BorderThickness="1" BorderBrush="{DynamicResource Brush.Border1}" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <v:ImageView Image="{Binding Old}"
                                 Zoom="{Binding #ImageZoomSlider.Value}"
                                 ShowChangeOutlines="{Binding Source={x:Static vm:Preferences.Instance}, Path=HighlightImageDiffChanges}"
                                 ChangeOutlines="{Binding ChangeOutlines}"/>
                  </Border>
                </ScrollViewer>
              </Border>
            </Border>
          </Grid>

          <Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="8,0" IsVisible="{Binding New, Converter={x:Static ObjectConverters.IsNotNull}}">
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
              <Border Height="16" Background="Green" CornerRadius="8" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource Text.Diff.New}" Margin="8,0" FontSize="10" Foreground="White"/>
              </Border>

              <TextBlock Text="{Binding NewImageSize}" Margin="8,0,0,0"/>
              <TextBlock Text="{Binding NewFileSize, Converter={x:Static c:LongConverters.ToFileSize}}" Foreground="{DynamicResource Brush.FG2}" Margin="16,0,0,0"/>
            </StackPanel>

            <Border Grid.Row="1" Margin="0,4,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Effect="drop-shadow(0 0 8 #A0000000)">
              <Border Background="{DynamicResource Brush.Popup}" Padding="8">
                <ScrollViewer x:Name="NewImageScrollViewer"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              ScrollChanged="OnNewImageScrollChanged"
                              PointerWheelChanged="OnImagePointerWheelChanged"
                              PointerPressed="OnImagePointerPressed"
                              PointerMoved="OnImagePointerMoved"
                              PointerReleased="OnImagePointerReleased"
                              PointerCaptureLost="OnImagePointerCaptureLost">
                  <Border BorderThickness="1" BorderBrush="{DynamicResource Brush.Border1}" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <v:ImageView Image="{Binding New}"
                                 Zoom="{Binding #ImageZoomSlider.Value}"
                                 ShowChangeOutlines="{Binding Source={x:Static vm:Preferences.Instance}, Path=HighlightImageDiffChanges}"
                                 ChangeOutlines="{Binding ChangeOutlines}"/>
                  </Border>
                </ScrollViewer>
              </Border>
            </Border>
          </Grid>
        </Grid>
      </TabItem>

      <TabItem>
        <TabItem.Header>
          <TextBlock Text="{DynamicResource Text.Diff.Image.Swipe}" FontSize="11"/>
        </TabItem.Header>

        <Grid RowDefinitions="Auto,*" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="8,8">
          <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" HorizontalAlignment="Center" Margin="0,0,0,6">
            <Border Grid.Column="0" Height="16" Background="{DynamicResource Brush.Badge}" CornerRadius="8" VerticalAlignment="Center">
              <TextBlock Text="{DynamicResource Text.Diff.Old}" Margin="8,0" FontSize="10" Foreground="{DynamicResource Brush.BadgeFG}"/>
            </Border>

            <TextBlock Grid.Column="1" Text="{Binding OldImageSize}" Margin="8,0,0,0"/>
            <TextBlock Grid.Column="2" Text="{Binding OldFileSize, Converter={x:Static c:LongConverters.ToFileSize}}" Foreground="{DynamicResource Brush.FG2}" Margin="16,0,0,0"/>

            <Border Grid.Column="3" Height="16" Background="Green" CornerRadius="8" VerticalAlignment="Center" Margin="32,0,0,0">
              <TextBlock Text="{DynamicResource Text.Diff.New}" Margin="8,0" FontSize="10" Foreground="White"/>
            </Border>

            <TextBlock Grid.Column="4" Text="{Binding NewImageSize}" Margin="8,0,0,0"/>
            <TextBlock Grid.Column="5" Text="{Binding NewFileSize, Converter={x:Static c:LongConverters.ToFileSize}}" Foreground="{DynamicResource Brush.FG2}" Margin="16,0,0,0"/>
          </Grid>

          <Border Grid.Row="1" Margin="0,4,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Effect="drop-shadow(0 0 8 #A0000000)">
            <Border Background="{DynamicResource Brush.Window}">
              <ScrollViewer HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Auto"
                            PointerWheelChanged="OnImagePointerWheelChanged"
                            PointerPressed="OnImagePointerPressed"
                            PointerMoved="OnImagePointerMoved"
                            PointerReleased="OnImagePointerReleased"
                            PointerCaptureLost="OnImagePointerCaptureLost">
                <Border BorderThickness="1" BorderBrush="{DynamicResource Brush.Border1}" Margin="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <v:ImageSwipeControl OldImage="{Binding Old}"
                                       NewImage="{Binding New}"
                                       Zoom="{Binding #ImageZoomSlider.Value}"
                                       ShowChangeOutlines="{Binding Source={x:Static vm:Preferences.Instance}, Path=HighlightImageDiffChanges}"
                                       ChangeOutlines="{Binding ChangeOutlines}"
                                       RenderOptions.BitmapInterpolationMode="HighQuality"/>
                </Border>
              </ScrollViewer>
            </Border>
          </Border>
        </Grid>
      </TabItem>

      <TabItem>
        <TabItem.Header>
          <TextBlock Text="{DynamicResource Text.Diff.Image.Blend}" FontSize="11"/>
        </TabItem.Header>

        <Grid RowDefinitions="Auto,*,Auto" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="8,8,8,0">
          <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" HorizontalAlignment="Center" Margin="0,0,0,6">
            <Border Grid.Column="0" Height="16" Background="{DynamicResource Brush.Badge}" CornerRadius="8" VerticalAlignment="Center">
              <TextBlock Text="{DynamicResource Text.Diff.Old}" Margin="8,0" FontSize="10" Foreground="{DynamicResource Brush.BadgeFG}"/>
            </Border>

            <TextBlock Grid.Column="1" Text="{Binding OldImageSize}" Margin="8,0,0,0"/>
            <TextBlock Grid.Column="2" Text="{Binding OldFileSize, Converter={x:Static c:LongConverters.ToFileSize}}" Foreground="{DynamicResource Brush.FG2}" Margin="16,0,0,0"/>

            <Border Grid.Column="3" Height="16" Background="Green" CornerRadius="8" VerticalAlignment="Center" Margin="32,0,0,0">
              <TextBlock Text="{DynamicResource Text.Diff.New}" Margin="8,0" FontSize="10" Foreground="White"/>
            </Border>

            <TextBlock Grid.Column="4" Text="{Binding NewImageSize}" Margin="8,0,0,0"/>
            <TextBlock Grid.Column="5" Text="{Binding NewFileSize, Converter={x:Static c:LongConverters.ToFileSize}}" Foreground="{DynamicResource Brush.FG2}" Margin="16,0,0,0"/>
          </Grid>

          <Border Grid.Row="1" Margin="0,4,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Effect="drop-shadow(0 0 8 #A0000000)">
            <Border Background="{DynamicResource Brush.Window}">
              <ScrollViewer HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Auto"
                            PointerWheelChanged="OnImagePointerWheelChanged"
                            PointerPressed="OnImagePointerPressed"
                            PointerMoved="OnImagePointerMoved"
                            PointerReleased="OnImagePointerReleased"
                            PointerCaptureLost="OnImagePointerCaptureLost">
                <Border BorderThickness="1" BorderBrush="{DynamicResource Brush.Border1}" Margin="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <v:ImageBlendControl Alpha="{Binding #ImageBlendSlider.Value}"
                                       OldImage="{Binding Old}"
                                       NewImage="{Binding New}"
                                       Zoom="{Binding #ImageZoomSlider.Value}"
                                       ShowChangeOutlines="{Binding Source={x:Static vm:Preferences.Instance}, Path=HighlightImageDiffChanges}"
                                       ChangeOutlines="{Binding ChangeOutlines}"/>
                </Border>
              </ScrollViewer>
            </Border>
          </Border>

          <Grid Grid.Row="2" ColumnDefinitions="100,200,100" Margin="0,8,0,0" HorizontalAlignment="Center">
            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,8,0">
              <TextBlock Margin="0,0,8,0"
                         Text="{Binding #ImageBlendSlider.Value, Converter={x:Static c:DoubleConverters.OneMinusToPercentage}}"
                         Foreground="{DynamicResource Brush.FG2}"/>
              <TextBlock Text="{DynamicResource Text.Diff.Old}"/>
            </StackPanel>

            <Slider Grid.Column="1"
                    x:Name="ImageBlendSlider"
                    Minimum="0" Maximum="1"
                    VerticalAlignment="Top"
                    TickFrequency="0.5"
                    TickPlacement="BottomRight"
                    Margin="0"
                    MinHeight="0"
                    Foreground="{DynamicResource Brush.Border1}"
                    Value="0.5"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,0,0,0">
              <TextBlock Text="{DynamicResource Text.Diff.New}"/>
              <TextBlock Margin="8,0,0,0"
                         Text="{Binding #ImageBlendSlider.Value, Converter={x:Static c:DoubleConverters.ToPercentage}}"
                         Foreground="{DynamicResource Brush.FG2}"/>
            </StackPanel>
          </Grid>
        </Grid>
      </TabItem>

      <TabItem>
        <TabItem.Header>
          <TextBlock Text="{DynamicResource Text.Diff.Image.Difference}" FontSize="11"/>
        </TabItem.Header>

        <Grid RowDefinitions="Auto,*,Auto" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="8,8,8,0">
          <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" HorizontalAlignment="Center" Margin="0,0,0,6">
            <Border Grid.Column="0" Height="16" Background="{DynamicResource Brush.Badge}" CornerRadius="8" VerticalAlignment="Center">
              <TextBlock Text="{DynamicResource Text.Diff.Old}" Margin="8,0" FontSize="10" Foreground="{DynamicResource Brush.BadgeFG}"/>
            </Border>

            <TextBlock Grid.Column="1" Text="{Binding OldImageSize}" Margin="8,0,0,0"/>
            <TextBlock Grid.Column="2" Text="{Binding OldFileSize, Converter={x:Static c:LongConverters.ToFileSize}}" Foreground="{DynamicResource Brush.FG2}" Margin="16,0,0,0"/>

            <Border Grid.Column="3" Height="16" Background="Green" CornerRadius="8" VerticalAlignment="Center" Margin="32,0,0,0">
              <TextBlock Text="{DynamicResource Text.Diff.New}" Margin="8,0" FontSize="10" Foreground="White"/>
            </Border>

            <TextBlock Grid.Column="4" Text="{Binding NewImageSize}" Margin="8,0,0,0"/>
            <TextBlock Grid.Column="5" Text="{Binding NewFileSize, Converter={x:Static c:LongConverters.ToFileSize}}" Foreground="{DynamicResource Brush.FG2}" Margin="16,0,0,0"/>
          </Grid>

          <Border Grid.Row="1" Margin="0,4,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Effect="drop-shadow(0 0 8 #A0000000)">
            <Border Background="{DynamicResource Brush.Window}">
              <ScrollViewer HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Auto"
                            PointerWheelChanged="OnImagePointerWheelChanged"
                            PointerPressed="OnImagePointerPressed"
                            PointerMoved="OnImagePointerMoved"
                            PointerReleased="OnImagePointerReleased"
                            PointerCaptureLost="OnImagePointerCaptureLost">
                <Border BorderThickness="1" BorderBrush="{DynamicResource Brush.Border1}" Margin="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <v:ImageDifferenceControl Alpha="{Binding #ImageDifferenceSlider.Value}"
                                            OldImage="{Binding Old}"
                                            NewImage="{Binding New}"
                                            Zoom="{Binding #ImageZoomSlider.Value}"
                                            ShowChangeOutlines="{Binding Source={x:Static vm:Preferences.Instance}, Path=HighlightImageDiffChanges}"
                                            ChangeOutlines="{Binding ChangeOutlines}"/>
                </Border>
              </ScrollViewer>
            </Border>
          </Border>

          <Grid Grid.Row="2" ColumnDefinitions="100,200,100" Margin="0,8,0,0" HorizontalAlignment="Center">
            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,8,0">
              <TextBlock Margin="0,0,8,0"
                         Text="{Binding #ImageDifferenceSlider.Value, Converter={x:Static c:DoubleConverters.OneMinusToPercentage}}"
                         Foreground="{DynamicResource Brush.FG2}"/>
              <TextBlock Text="{DynamicResource Text.Diff.Old}"/>
            </StackPanel>

            <Slider Grid.Column="1"
                    x:Name="ImageDifferenceSlider"
                    Minimum="0" Maximum="1"
                    VerticalAlignment="Top"
                    TickFrequency="0.5"
                    TickPlacement="BottomRight"
                    Margin="0"
                    MinHeight="0"
                    Foreground="{DynamicResource Brush.Border1}"
                    Value="0.5"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,0,0,0">
              <TextBlock Text="{DynamicResource Text.Diff.New}"/>
              <TextBlock Margin="8,0,0,0"
                         Text="{Binding #ImageDifferenceSlider.Value, Converter={x:Static c:DoubleConverters.ToPercentage}}"
                         Foreground="{DynamicResource Brush.FG2}"/>
            </StackPanel>
          </Grid>
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
