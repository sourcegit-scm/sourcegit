<v:ChromelessWindow xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:v="using:SourceGit.Views"
                    xmlns:ai="using:SourceGit.AI"
                    mc:Ignorable="d" d:DesignWidth="512" d:DesignHeight="450"
                    x:Class="SourceGit.Views.EditApiKey"
                    x:DataType="ai:ApiKey"
                    x:Name="ThisControl"
                    Icon="/App.ico"
                    Title="{DynamicResource Text.EditApiKey}"
                    SizeToContent="Height"
                    Width="512"
                    CanResize="False"
                    WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,*">
    <!-- TitleBar -->
    <Grid Grid.Row="0" Height="28" IsVisible="{Binding !#ThisControl.UseSystemWindowFrame}">
      <Border Background="{DynamicResource Brush.TitleBar}"
              BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Border0}"
              PointerPressed="BeginMoveWindow"/>

      <Path Width="14" Height="14"
            Margin="10,0,0,0"
            HorizontalAlignment="Left"
            Data="{StaticResource Icons.Password}"
            IsVisible="{OnPlatform True, macOS=False}"/>

      <TextBlock Classes="bold"
                 Text="{DynamicResource Text.EditApiKey}"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 IsHitTestVisible="False"/>

      <v:CaptionButtons HorizontalAlignment="Right"
                        IsCloseButtonOnly="True"
                        IsVisible="{OnPlatform True, macOS=False}"/>
    </Grid>

    <StackPanel Grid.Row="1" Margin="16" Orientation="Vertical">
      <TextBlock Text="{DynamicResource Text.EditApiKey.Server}"/>
      <TextBox Margin="0,4,0,0"
               CornerRadius="3"
               Height="28"
               Text="{Binding Service, Mode=OneWay}"
               IsReadOnly="True"/>

      <TextBlock Margin="0,12,0,0" Text="{DynamicResource Text.EditApiKey.Storage}"/>
      <ComboBox Margin="0,4,0,0" Height="28" HorizontalAlignment="Stretch" SelectedIndex="{Binding Storage, Mode=TwoWay}">
        <ComboBoxItem Content="Environment Variable"/>
        <ComboBoxItem Content="System Keychain"/>
        <ComboBoxItem Content="Plain Text"/>
      </ComboBox>

      <TextBlock Margin="0,12,0,0"
                 Text="{DynamicResource Text.EditApiKey.EnvironmentVariable}"
                 IsVisible="{Binding Storage, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static ai:ApiKeyStorage.EnvironmentVariable}}"/>
      <TextBox Margin="0,4,0,0"
               CornerRadius="3"
               Height="28"
               Text="{Binding KeyToAccess, Mode=TwoWay}"
               IsVisible="{Binding Storage, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static ai:ApiKeyStorage.EnvironmentVariable}}"/>
      
      <TextBlock Margin="0,12,0,0"
                 Text="{DynamicResource Text.EditApiKey.ApiKey}"
                 IsVisible="{Binding Storage, Converter={x:Static ObjectConverters.NotEqual}, ConverterParameter={x:Static ai:ApiKeyStorage.EnvironmentVariable}}"/>
      <TextBox Margin="0,4,0,0"
               CornerRadius="3"
               Height="28"
               PasswordChar="*"
               RevealPassword="{Binding #ToggleShowPassword.IsChecked, Mode=OneWay}"
               Text="{Binding KeyToAccess, Mode=TwoWay}"
               IsEnabled="{Binding IsValidStorage}"
               IsVisible="{Binding Storage, Converter={x:Static ObjectConverters.NotEqual}, ConverterParameter={x:Static ai:ApiKeyStorage.EnvironmentVariable}}">
        <TextBox.InnerRightContent>
          <ToggleButton Grid.Column="6"
                        x:Name="ToggleShowPassword"
                        Classes="toggle_untracked"
                        Width="26" Height="14"/>
        </TextBox.InnerRightContent>
      </TextBox>
      <Grid ColumnDefinitions="Auto,*"
            Margin="0,4,0,0"
            IsVisible="{Binding !IsValidStorage, Mode=OneWay}">
        <Path Grid.Column="0"
              Width="12" Height="12"
              Data="{StaticResource Icons.Error}"
              Fill="DarkOrange"/>
        <TextBlock Grid.Column="1"
                   Margin="6,0,0,0"
                   Text="{DynamicResource Text.EditApiKey.InvalidStorage}"
                   FontSize="12"
                   Foreground="{DynamicResource Brush.FG2}"
                   TextWrapping="Wrap"/>
      </Grid>                 

      <StackPanel Margin="0,12,0,0" Orientation="Horizontal" HorizontalAlignment="Center">
        <Button Classes="flat primary"
                Width="80"
                Content="{DynamicResource Text.Sure}"
                IsEnabled="{Binding IsValidStorage}"
                Click="ApplyChange"
                HotKey="Enter"/>

        <Button Classes="flat"
                Width="80"
                Margin="8,0,0,0"
                Content="{DynamicResource Text.Cancel}"
                Click="CloseWindow"/>
      </StackPanel>
    </StackPanel>
  </Grid>
</v:ChromelessWindow>
