<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SourceGit.ViewModels"
             xmlns:m="using:SourceGit.Models"
             xmlns:v="using:SourceGit.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SourceGit.Views.CommitChanges"
             x:DataType="vm:CommitDetail">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="{Binding Source={x:Static vm:Preferences.Instance}, Path=Layout.CommitDetailChangesLeftWidth, Mode=TwoWay}" MinWidth="200"/>
      <ColumnDefinition Width="4"/>
      <ColumnDefinition Width="*" MinWidth="100"/>
    </Grid.ColumnDefinitions>

    <Grid Grid.Column="0" RowDefinitions="26,*,26">
      <!-- Search & Display Mode -->
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
        <TextBox Grid.Column="0"
                 x:Name="CommitChangeSearchBox"
                 Height="26"
                 BorderThickness="1" BorderBrush="{DynamicResource Brush.Border2}"
                 Background="Transparent"
                 CornerRadius="4"
                 Watermark="{DynamicResource Text.CommitDetail.Changes.Search}"
                 Text="{Binding SearchChangeFilter, Mode=TwoWay}">
          <TextBox.InnerLeftContent>
            <Path Width="14" Height="14" Margin="4,0,0,0" Fill="{DynamicResource Brush.FG2}" Data="{StaticResource Icons.Search}"/>
          </TextBox.InnerLeftContent>

          <TextBox.InnerRightContent>
            <Button Classes="icon_button"
                    Focusable="False"
                    IsVisible="{Binding SearchChangeFilter, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                    Command="{Binding ClearSearchChangeFilter}">
              <Path Width="14" Height="14" Fill="{DynamicResource Brush.FG2}" Data="{StaticResource Icons.Clear}"/>
            </Button>
          </TextBox.InnerRightContent>
        </TextBox>

        <v:ChangeViewModeSwitcher Grid.Column="1"
                                  Width="18" Height="18"
                                  Margin="4,0,0,0"
                                  ViewMode="{Binding Source={x:Static vm:Preferences.Instance}, Path=ChangeViewMode, Mode=TwoWay}"/>
      </Grid>

      <!-- Changes -->
      <Border Grid.Row="1"
              Margin="0,4,0,0"
              BorderBrush="{DynamicResource Brush.Border2}"
              BorderThickness="1"
              CornerRadius="4,4,0,0">
        <Border CornerRadius="4,4,0,0"
                Background="{DynamicResource Brush.Contents}"
                ClipToBounds="True">
          <v:ChangeCollectionView ViewMode="{Binding Source={x:Static vm:Preferences.Instance}, Path=ChangeViewMode}"
                                  EnableCompactFolders="{Binding Source={x:Static vm:Preferences.Instance}, Path=EnableCompactFoldersInChangesTree}"
                                  Changes="{Binding VisibleChanges, Mode=OneWay}"
                                  Selection="{Binding ChangeSelection, Mode=TwoWay}"
                                  ContextRequested="OnChangeContextRequested"
                                  KeyDown="OnChangeCollectionViewKeyDown"/>
        </Border>
      </Border>
      

      <!-- Summary -->
      <Border Grid.Row="2" CornerRadius="0,0,4,4" BorderBrush="{DynamicResource Brush.Border2}" BorderThickness="1,0,1,1" Background="Transparent">
        <TextBlock Margin="4,0,0,0"
                   Foreground="{DynamicResource Brush.FG2}"
                   HorizontalAlignment="Left" VerticalAlignment="Center">
          <Run Text="{Binding Changes.Count, Mode=OneWay}" FontWeight="Bold"/>
          <Run Text="{DynamicResource Text.CommitDetail.Changes.Count}"/>
        </TextBlock>
      </Border>
    </Grid>

    <GridSplitter Grid.Column="1"
                  MinWidth="1"
                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                  Background="Transparent"
                  Focusable="False"/>

    <Grid Grid.Column="2" x:Name="ChangesDiffArea" SizeChanged="OnDiffAreaSizeChanged">
      <Grid.RowDefinitions>
        <RowDefinition Height="{Binding Source={x:Static vm:Preferences.Instance}, Path=Layout.CommitDetailChangesMessageRowHeight, Mode=TwoWay}" MinHeight="28"/>
        <RowDefinition Height="4"/>
        <RowDefinition Height="*" MinHeight="80"/>
      </Grid.RowDefinitions>

      <Border Grid.Row="0" x:Name="CommitMessageArea" CornerRadius="4"
              BorderThickness="1" BorderBrush="{DynamicResource Brush.Border2}"
              Background="{DynamicResource Brush.Contents}" ClipToBounds="True">
        <Grid ColumnDefinitions="*,24" Margin="6,3,3,3">
          <ScrollViewer Grid.Column="0" x:Name="CommitMessageScrollViewer"
                        HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                        Offset="{Binding ChangesMessageScrollOffset, Mode=TwoWay}"
                        IsVisible="{Binding Source={x:Static vm:Preferences.Instance}, Path=Layout.IsCommitDetailChangesMessageExpanded}">
            <v:CommitMessagePresenter x:Name="ChangesCommitMessage"
                                      FullMessage="{Binding FullMessage}"
                                      FontSize="{Binding Source={x:Static vm:Preferences.Instance}, Path=DefaultFontSize}"
                                      Foreground="{DynamicResource Brush.FG1}"
                                      HorizontalAlignment="Stretch" VerticalAlignment="Top" TextWrapping="Wrap">
              <ToolTip.IsOpen>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                  <Binding Path="$self.IsPointerOver"/>
                  <Binding Path="$self.(ToolTip.Tip)" Converter="{x:Static ObjectConverters.IsNotNull}"/>
                </MultiBinding>
              </ToolTip.IsOpen>
              <v:CommitMessagePresenter.ContextFlyout>
                <MenuFlyout>
                  <MenuItem Header="{DynamicResource Text.Copy}"
                            Command="{Binding $parent[SelectableTextBlock].Copy}"
                            IsEnabled="{Binding $parent[SelectableTextBlock].CanCopy}"
                            InputGesture="{x:Static TextBox.CopyGesture}"/>
                  <MenuItem Header="{DynamicResource Text.CopyAllText}" Click="OnCopyCommitMessage"/>
                </MenuFlyout>
              </v:CommitMessagePresenter.ContextFlyout>
              <v:CommitMessagePresenter.DataTemplates>
                <DataTemplate DataType="m:Commit">
                  <StackPanel MinWidth="300" MaxWidth="500">
                    <TextBlock Text="{Binding Author.Name}" Foreground="{DynamicResource Brush.FG2}"/>
                    <TextBlock Text="{Binding Subject}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                  </StackPanel>
                </DataTemplate>
              </v:CommitMessagePresenter.DataTemplates>
            </v:CommitMessagePresenter>
          </ScrollViewer>

          <SelectableTextBlock Grid.Column="0" x:Name="CollapsedCommitMessage"
                               Text="{Binding Commit.Subject}" MaxLines="1" TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               IsVisible="{Binding Source={x:Static vm:Preferences.Instance}, Path=!Layout.IsCommitDetailChangesMessageExpanded}"/>

          <ToggleButton Grid.Column="1" x:Name="CommitMessageToggle" Classes="line_path"
                        Width="20" Height="20" VerticalAlignment="Top" Focusable="False"
                        IsChecked="{Binding Source={x:Static vm:Preferences.Instance}, Path=Layout.IsCommitDetailChangesMessageExpanded, Mode=TwoWay}">
            <ToggleButton.Styles>
              <Style Selector="ToggleButton">
                <Setter Property="ToolTip.Tip" Value="{DynamicResource Text.CommitDetail.Changes.Message.Expand}"/>
              </Style>
              <Style Selector="ToggleButton:checked">
                <Setter Property="ToolTip.Tip" Value="{DynamicResource Text.CommitDetail.Changes.Message.Collapse}"/>
              </Style>
            </ToggleButton.Styles>
            <Grid>
              <Path Width="12" Height="12" Data="{StaticResource Icons.Up}"
                    IsVisible="{Binding Source={x:Static vm:Preferences.Instance}, Path=Layout.IsCommitDetailChangesMessageExpanded}"/>
              <Path Width="12" Height="12" Data="{StaticResource Icons.Down}"
                    IsVisible="{Binding Source={x:Static vm:Preferences.Instance}, Path=!Layout.IsCommitDetailChangesMessageExpanded}"/>
            </Grid>
          </ToggleButton>
        </Grid>
      </Border>

      <GridSplitter Grid.Row="1" x:Name="CommitMessageSplitter" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent"
                    BorderBrush="{DynamicResource Brush.Border2}" BorderThickness="0,1,0,0" Focusable="False"
                    IsEnabled="{Binding Source={x:Static vm:Preferences.Instance}, Path=Layout.IsCommitDetailChangesMessageExpanded}"/>

      <Border Grid.Row="2" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource Brush.Border2}">
        <StackPanel Orientation="Vertical" VerticalAlignment="Center">
          <Path Width="64" Height="64" Data="{StaticResource Icons.Diff}" Fill="{DynamicResource Brush.FG2}"/>
          <TextBlock Margin="0,16,0,0"
                     Text="{DynamicResource Text.Diff.Welcome}"
                     FontSize="18" FontWeight="Bold"
                     Foreground="{DynamicResource Brush.FG2}"
                     HorizontalAlignment="Center"/>
        </StackPanel>
      </Border>

      <ContentControl Grid.Row="2" x:Name="ChangesDiffContent" Content="{Binding DiffContext}">
        <ContentControl.DataTemplates>
          <DataTemplate DataType="vm:DiffContext">
            <v:DiffView/>
          </DataTemplate>
        </ContentControl.DataTemplates>
      </ContentControl>
    </Grid>
  </Grid>
</UserControl>
