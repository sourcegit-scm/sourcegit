<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DevBoard.ViewModels"
             xmlns:v="using:DevBoard.Views"
             x:Class="DevBoard.Views.DevSpaces"
             x:DataType="vm:DevSpaces">
  <Grid RowDefinitions="36,*">
    <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Border2}" Background="{DynamicResource Brush.ToolBar}">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto">
        <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <StackPanel Orientation="Horizontal">
            <Border Height="32" Margin="2,2,0,2" Padding="10,0" CornerRadius="4" Background="{DynamicResource Brush.Contents}" PointerPressed="OnDashboardTabPressed"><TextBlock VerticalAlignment="Center" Text="{DynamicResource Text.DevSpaces.Dashboard}"/></Border>
            <Border Height="32" Margin="2,2,0,2" Padding="10,0" CornerRadius="4" Background="{DynamicResource Brush.Contents}" PointerPressed="OnFilesTabPressed"><StackPanel Orientation="Horizontal" Spacing="6"><Path Width="13" Height="13" VerticalAlignment="Center" Data="{StaticResource Icons.Folder}"/><TextBlock VerticalAlignment="Center" Text="{DynamicResource Text.DevSpaces.Files}"/></StackPanel></Border>
            <Border Height="32" Margin="2,2,0,2" Padding="10,0" CornerRadius="4" Background="{DynamicResource Brush.Contents}" PointerPressed="OnAIRouterTabPressed"><StackPanel Orientation="Horizontal" Spacing="6"><Path Width="13" Height="13" VerticalAlignment="Center" Data="{StaticResource Icons.AIAssist}"/><TextBlock VerticalAlignment="Center" Text="AI Router"/></StackPanel></Border>
            <Border Height="32" Margin="2,2,0,2" Padding="10,0" CornerRadius="4" Background="{DynamicResource Brush.Contents}" PointerPressed="OnTerminalsTabPressed"><StackPanel Orientation="Horizontal" Spacing="6"><Path Width="13" Height="13" VerticalAlignment="Center" Data="{StaticResource Icons.Terminal}"/><TextBlock VerticalAlignment="Center" Text="{DynamicResource Text.DevSpaces.Terminals}"/></StackPanel></Border>
            <ItemsControl ItemsSource="{Binding Sessions}" IsVisible="{Binding IsTerminalsActive}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:DevSpaceTerminal"><Border Height="32" Margin="2,2,0,2" Padding="8,0,2,0" CornerRadius="4" Background="{DynamicResource Brush.Contents}" PointerPressed="OnTerminalTabPressed"><Grid ColumnDefinitions="Auto,Auto"><TextBlock VerticalAlignment="Center" Text="{Binding Title}"/><Button Grid.Column="1" Classes="icon_button" Width="24" Height="24" Margin="4,0,0,0" Click="OnCloseTerminal" ToolTip.Tip="{DynamicResource Text.DevSpaces.CloseTerminal}"><Path Width="10" Height="10" Data="{StaticResource Icons.Clear}"/></Button></Grid></Border></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
        <Border Grid.Column="1" Height="28" Margin="8,4,0,4" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource Brush.Border2}" IsVisible="{Binding IsTerminalsActive}"><StackPanel Orientation="Horizontal"><Button Classes="flat" Height="26" Padding="8,0" Content="▦ Grid" Click="OnGridLayout" ToolTip.Tip="Grid terminals"/><Button Classes="flat" Height="26" Padding="8,0" Content="☰ List" Click="OnListLayout" ToolTip.Tip="List terminals"/></StackPanel></Border>
        <ComboBox Grid.Column="2" Width="92" Height="28" Margin="4,4,0,4" IsVisible="{Binding IsGridLayout}" SelectedIndex="{Binding LayoutIndex, Mode=TwoWay}"><ComboBoxItem Content="{DynamicResource Text.DevSpaces.Layout.Auto}"/><ComboBoxItem Content="{DynamicResource Text.DevSpaces.Layout.1x2}"/><ComboBoxItem Content="{DynamicResource Text.DevSpaces.Layout.2x2}"/><ComboBoxItem Content="{DynamicResource Text.DevSpaces.Layout.3x3}"/></ComboBox>
        <Button Grid.Column="3" Classes="icon_button" Width="30" Height="30" Margin="4,3,6,3" IsVisible="{Binding IsTerminalsActive}" Click="OnCreateTerminal" ToolTip.Tip="{DynamicResource Text.DevSpaces.NewTerminal}"><Path Width="13" Height="13" Data="{StaticResource Icons.Plus}"/></Button>
      </Grid>
    </Border>
    <Grid Grid.Row="1"><v:DevSpaceDashboard x:Name="DashboardView" DataContext="{Binding Dashboard}"/><v:DevSpaceFiles x:Name="FilesView" DataContext="{Binding Files}"/><v:DevSpaceAIRouter x:Name="AIRouterView" IsVisible="False"/><Grid x:Name="TerminalGrid" Margin="2"/></Grid>
  </Grid>
</UserControl>
