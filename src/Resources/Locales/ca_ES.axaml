  <x:String x:Key="Text.Configure.CommitMessageTemplate" xml:space="preserve">PLANTILLA DE COMISSIÓ</x:String>
  <x:String x:Key="Text.Configure.CommitMessageTemplate.BuiltinVars" xml:space="preserve">Paràmetres integrats:

  ${branch_name} Nom de la branca local actual.
  ${files_num} Nombre de fitxers modificats
  ${files} Rutes dels fitxers modificats
  ${files:N} Nombre màxim N de rutes dels fitxers modificats
  ${pure_files} Com ${files}, però només els noms dels fitxers
  ${pure_files:N} Com ${files:N}, però sense carpetes</x:String>
  <x:String x:Key="Text.Configure.CommitMessageTemplate.Content" xml:space="preserve">Contingut de la plantilla:</x:String>
  <x:String x:Key="Text.Configure.CommitMessageTemplate.Name" xml:space="preserve">Nom de la plantilla:</x:String>
